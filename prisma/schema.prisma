generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String
  bio          String   @default("")
  createdAt    DateTime @default(now())
  reviews      Review[]
}

// Cache local dos jogos avaliados (evita chamar a RAWG para listar avaliações)
model Game {
  rawgId   Int      @id
  name     String
  slug     String
  imageUrl String?
  released String?
  reviews  Review[]
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  rawgGameId Int
  rating     Int // 1 a 10 (10 = 5 estrelas, 1 = meia estrela)
  text       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game     @relation(fields: [rawgGameId], references: [rawgId])

  @@unique([userId, rawgGameId])
  @@index([rawgGameId])
}
