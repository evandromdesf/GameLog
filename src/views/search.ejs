<%- include('partials/header') %>
<h1>Jogos</h1>
<form method="get" action="/games" class="grid">
  <input type="search" name="search" placeholder="Nome do jogo" value="<%= search %>" maxlength="100">
  <select name="genres">
    <option value="">Todos os gêneros</option>
    <% genreList.forEach(g => { %>
      <option value="<%= g.slug %>" <%= g.slug === genres ? 'selected' : '' %>><%= g.name %></option>
    <% }) %>
  </select>
  <input type="number" name="year" placeholder="Ano de lançamento" min="1970" max="2100" value="<%= year %>">
  <button>Buscar</button>
</form>

<% if (error) { %><article class="flash error"><%= error %></article><% } %>
<% if (!error && games.length === 0) { %><p>Nenhum jogo encontrado.</p><% } %>

<div class="grid-cards">
  <% games.forEach(g => { %><%- include('partials/game-card', { g }) %><% }) %>
</div>

<nav class="pager">
  <% if (prevUrl) { %><a href="<%= prevUrl %>" role="button" class="outline">← Anterior</a><% } %>
  <small>Página <%= page %></small>
  <% if (nextUrl) { %><a href="<%= nextUrl %>" role="button" class="outline">Próxima →</a><% } %>
</nav>
<%- include('partials/footer') %>
