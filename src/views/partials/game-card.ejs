<article class="game-card" data-theme="dark">
  <a href="/games/<%= g.id %>">
    <div class="capa">
      <% if (g.background_image) { %>
        <img src="<%= thumb(g.background_image) %>" alt="" loading="lazy">
      <% } %>
    </div>

    <h4><%= g.name %></h4>
  </a>

  <small><%= g.released ? g.released.split('-').reverse().join('/') : 'Sem data' %></small>
</article>
