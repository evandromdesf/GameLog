<!doctype html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' · GameLog' : 'GameLog' %></title>
  <link rel="stylesheet" href="/pico/pico.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="container">
  <nav>
    <ul><li><a href="/"><strong>🎮 GameLog</strong></a></li></ul>
    <ul>
      <li><a href="/games">Jogos</a></li>
      <% if (user) { %>
        <li><a href="/users/<%= user.username %>">@<%= user.username %></a></li>
        <li>
          <form method="post" action="/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="outline secondary">Sair</button>
          </form>
        </li>
      <% } else { %>
        <li><a href="/login">Entrar</a></li>
        <li><a href="/register" role="button">Criar conta</a></li>
      <% } %>
    </ul>
  </nav>
</header>
<main class="container">
  <% if (flash) { %>
    <article class="flash <%= flash.type %>"><%= flash.message %></article>
  <% } %>
