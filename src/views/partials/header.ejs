<!doctype html>
<html lang="pt-BR" data-theme="<%= locals.dark ? 'dark' : 'light' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' · GameLog' : 'GameLog' %></title>
  <link rel="stylesheet" href="/pico/pico.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topo" data-theme="dark">
  <div class="container topo-linha">
    <a href="/" class="logo" aria-label="GameLog, página inicial">
      <img src="/img/logo.png" alt="" class="logo-img">

      <span class="logo-texto">
        <span class="logo-game">GAME</span>
        <span class="logo-log">LOG</span>
      </span>
    </a>

    <nav class="menu" aria-label="Principal">
      <a href="/games" role="button" class="outline">jogos</a>

      <% if (user) { %>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="outline">sair</button>
        </form>

        <a href="/users/<%= user.username %>" role="button">
          <img src="/img/usuario.png" alt="" class="icone-usuario">
          <span>perfil</span>
        </a>
      <% } else { %>
        <a href="/login" role="button" class="outline">entrar</a>

        <a href="/register" role="button">
          <img src="/img/usuario.png" alt="" class="icone-usuario">
          <span>criar<br>conta</span>
        </a>
      <% } %>
    </nav>
  </div>
</header>
<main class="container">
  <% if (flash) { %>
    <article class="flash <%= flash.type %>"><%= flash.message %></article>
  <% } %>
