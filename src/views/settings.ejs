<%- include('partials/header') %>
<h1>Configurações</h1>
<form method="post" action="/settings">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>E-mail <input type="email" name="email" value="<%= values.email || '' %>" required></label>
  <label>Bio <textarea name="bio" maxlength="300" rows="3"><%= values.bio || '' %></textarea></label>
  <button>Salvar</button>
</form>
<%- include('partials/footer') %>
