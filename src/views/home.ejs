<%- include('partials/header') %>

<section class="intro">
  <h1>Registre e avalie os jogos que você jogou</h1>
  <p><small>um mini letterboxd para games. dê notas, escreva reviews e descubra o que a comunidade acha.</small></p>

  <search>
    <form method="get" action="/games" class="busca">
      <label for="busca-home" class="sr-only">Buscar um jogo</label>
      <input id="busca-home" type="text" name="search" maxlength="100">

      <button class="outline buscar">
        <span>buscar</span>
        <span class="icone-diamante" aria-hidden="true"></span>
      </button>
    </form>
  </search>
</section>

<h2>Populares</h2>

<% if (popular.length === 0) { %>
  <p>Não foi possível carregar os jogos agora.</p>
<% } else { %>
  <div class="grid-cards">
    <% popular.forEach(g => { %>
      <%- include('partials/game-card', { g }) %>
    <% }) %>
  </div>
<% } %>

<h2>Últimas avaliações</h2>

<% if (latest.length === 0) { %>
  <p>Ainda não há avaliações. Seja o primeiro!</p>
<% } %>

<% latest.forEach(r => { %>
  <%- include('partials/review-item', { r, showUser: true, showGame: true }) %>
<% }) %>

<%- include('partials/footer') %>
