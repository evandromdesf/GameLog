<%- include('partials/header') %>

<%
  const porNota = [...profile.reviews].sort((a, b) => b.rating - a.rating || b.createdAt - a.createdAt).slice(0, 4);
  const recentes = profile.reviews; // todas (a rota já limita a 50), para poder editar/apagar qualquer uma
  const nota = (r) => String(r / 2).replace('.', ',');
%>

<section class="perfil-topo">
  <div class="avatar" aria-hidden="true"><%= profile.username.charAt(0).toUpperCase() %></div>
  <h1 class="nome"><%= profile.username %></h1>
  <p><small>Membro desde <%= profile.createdAt.toLocaleDateString('pt-BR') %> · <%= profile.reviews.length %> avaliações</small></p>
</section>

<% if (editing) { %>
  <form method="post" action="/profile" class="bio-box">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>
      E-mail
      <input type="email" name="email" value="<%= profile.email %>" required>
    </label>

    <label>
      Bio
      <textarea name="bio" maxlength="300" rows="5"><%= profile.bio %></textarea>
    </label>

    <div class="actions">
      <button>Salvar</button>
      <a href="/users/<%= profile.username %>" role="button" class="outline secondary">Cancelar</a>
    </div>
  </form>
<% } else { %>
  <section class="bio-box">
    <h3>bio</h3>
    <p class="bio"><%= profile.bio || (isOwner ? 'Você ainda não escreveu uma bio.' : '') %></p>

    <% if (isOwner) { %>
      <p><small>E-mail (visível só para você): <%= profile.email %></small></p>
      <a href="/users/<%= profile.username %>?edit=1" role="button" class="outline small">Editar perfil</a>
    <% } %>
  </section>
<% } %>

<h2 class="sr-only">Jogos mais bem avaliados</h2>

<section class="melhores" data-theme="dark">
  <% if (porNota.length === 0) { %>
    <p>Nenhuma avaliação ainda.</p>
  <% } %>

  <% porNota.forEach(r => { %>
    <a class="melhor" href="/games/<%= r.game.rawgId %>">
      <% if (r.game.imageUrl) { %>
        <img src="<%= thumb(r.game.imageUrl) %>" alt="Capa de <%= r.game.name %>" loading="lazy">
      <% } else { %>
        <span class="sem-capa"></span>
      <% } %>

      <small><%= r.game.name %> · <%= nota(r.rating) %> <span class="star full"></span></small>
    </a>
  <% }) %>
</section>

<h2>Avaliações</h2>

<% if (profile.reviews.length === 0) { %><p>Nenhuma avaliação ainda.</p><% } %>

<% recentes.forEach(r => { %>
  <div class="ultimo">
    <a class="ultimo-jogo" href="/games/<%= r.game.rawgId %>" data-theme="dark">
      <% if (r.game.imageUrl) { %>
        <img src="<%= thumb(r.game.imageUrl) %>" alt="" loading="lazy">
      <% } %>

      <span><%= r.game.name %><br><small><%= nota(r.rating) %> <span class="star full"></span></small></span>
    </a>

    <div class="ultimo-review">
      <h3>review</h3>
      <p><%= r.text || 'Sem texto.' %></p>

      <% if (isOwner) { %>
        <div class="actions">
          <a href="/games/<%= r.game.rawgId %>?edit=1" role="button" class="outline secondary small">Editar</a>

          <form method="post" action="/reviews/<%= r.id %>/delete" class="inline-form" data-confirm="Apagar esta avaliação?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="outline secondary small">Apagar</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
<% }) %>

<%- include('partials/footer') %>
